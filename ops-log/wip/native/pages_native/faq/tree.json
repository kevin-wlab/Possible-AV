yleNames": ["sub"], "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "9a8225f7-da62-1fe8-4356-120e0c341305"}, "type": "String", "textContent": "What we do, how a job runs in New York and what it costs. If your question is not here, ask us."}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "a0a9c66a-b4fb-c853-aa6b-ee5c95455caa"}, "type": "Block", "styleNames": ["ctas"], "settings": {"tag": "div", "visibility": true, "block": {"tag": "div"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "a0a9c66a-b4fb-c853-aa6b-ee5c95455ca7"}, "type": "Link", "styleNames": ["btn"], "attributes": {"href": "/get-a-quote"}, "settings": {"visibility": true, "link": {"linkType": "url", "href": "/get-a-quote"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "a0a9c66a-b4fb-c853-aa6b-ee5c95455ca6"}, "type": "String", "textContent": "Get a quote \u2192"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "a0a9c66a-b4fb-c853-aa6b-ee5c95455ca9"}, "type": "Link", "styleNames": ["ghost"], "attributes": {"href": "/services"}, "settings": {"visibility": true, "link": {"linkType": "url", "href": "/services"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "a0a9c66a-b4fb-c853-aa6b-ee5c95455ca8"}, "type": "String", "textContent": "See the nine services"}]}]}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4854"}, "type": "Block", "styleNames": ["next"], "attributes": {"id": "work"}, "settings": {"tag": "section", "visibility": true, "block": {"tag": "section"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4831"}, "type": "Paragraph", "styleNames": ["mono", "eb"], "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4830"}, "type": "String", "textContent": "About the work"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4833"}, "type": "Heading", "settings": {"tag": "h2", "visibility": true, "headingLevel": 2}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4832"}, "type": "String", "textContent": "What we do."}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4853"}, "type": "Block", "styleNames": ["faq"], "settings": {"tag": "div", "visibility": true, "block": {"tag": "div"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef483a"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4836"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4834"}, "type": "String", "textContent": "What does Possible AV do?"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4838"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4837"}, "type": "String", "textContent": "AV rental, installation and production: displays, projection, audio, lighting and staging, live video, networks, interactive, fabrication, and the logistics to bring it all, done in house by one crew."}]}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4841"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef483d"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef483b"}, "type": "String", "textContent": "Do you own your equipment?"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef483f"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef483e"}, "type": "String", "textContent": "We own our core equipment and run it ourselves. Anything we do not carry, we source and bring in with everything else."}]}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef484b"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4844"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4842"}, "type": "String", "textContent": "Do you do LED walls?"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4849"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4845"}, "type": "String", "textContent": "LED walls are handled by our sister site, "}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4847"}, "type": "Link", "attributes": {"href": "https://ledwall.nyc"}, "settings": {"visibility": true, "link": {"linkType": "url", "href": "https://ledwall.nyc"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4846"}, "type": "String", "textContent": "ledwall.nyc"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4848"}, "type": "String", "textContent": ". We handle everything around them: signal, sound, networks and playback."}]}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4852"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef484e"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef484c"}, "type": "String", "textContent": "Can you make content, or just bring equipment?"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef4850"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "76ccdc04-c0e2-cfca-03a4-320e3aef484f"}, "type": "String", "textContent": "Both. Content, 3D and custom builds are made in house, and we play back content your team provides. If Resolume or TouchDesigner does it, we do it."}]}]}]}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c56"}, "type": "Block", "styleNames": ["next"], "attributes": {"id": "logistics"}, "settings": {"tag": "section", "visibility": true, "block": {"tag": "section"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c36"}, "type": "Paragraph", "styleNames": ["mono", "eb"], "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c35"}, "type": "String", "textContent": "Logistics"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c38"}, "type": "Heading", "settings": {"tag": "h2", "visibility": true, "headingLevel": 2}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c37"}, "type": "String", "textContent": "How a job runs."}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c55"}, "type": "Block", "styleNames": ["faq"], "settings": {"tag": "div", "visibility": true, "block": {"tag": "div"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c3f"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c3b"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c39"}, "type": "String", "textContent": "Where do you work?"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c3d"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c3c"}, "type": "String", "textContent": "We are based in Brooklyn, New York. For work outside New York, the same crew travels with the equipment."}]}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c46"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c42"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c40"}, "type": "String", "textContent": "How far ahead should we book?"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c44"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c43"}, "type": "String", "textContent": "As early as you can, especially for large or multi-city work. Tight timelines are worth a message too: tell us the date."}]}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c4d"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c49"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c47"}, "type": "String", "textContent": "Do you handle load-in and strike?"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c4b"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c4a"}, "type": "String", "textContent": "Yes. Our own truck and crew deliver, set up, run the event and take everything away."}]}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c54"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c50"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c4e"}, "type": "String", "textContent": "What if the venue is tricky?"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c52"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "8e535379-078e-3a8c-df29-1ac737e39c51"}, "type": "String", "textContent": "We check power, rigging and access early and plan around them before the day."}]}]}]}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "ecfeb363-affd-ace2-0b8a-de2183a41d61"}, "type": "Block", "styleNames": ["next"], "attributes": {"id": "pricing"}, "settings": {"tag": "section", "visibility": true, "block": {"tag": "section"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "ecfeb363-affd-ace2-0b8a-de2183a41d42"}, "type": "Paragraph", "styleNames": ["mono", "eb"], "settings": {"visibility": true}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "ecfeb363-affd-ace2-0b8a-de2183a41d41"}, "type": "String", "textContent": "Pricing and booking"}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "ecfeb363-affd-ace2-0b8a-de2183a41d44"}, "type": "Heading", "settings": {"tag": "h2", "visibility": true, "headingLevel": 2}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "ecfeb363-affd-ace2-0b8a-de2183a41d43"}, "type": "String", "textContent": "What it costs."}]}, {"id": {"component": "6a362c72491d6977ea71846c", "element": "ecfeb363-affd-ace2-0b8a-de2183a41d60"}, "type": "Block", "styleNames": ["faq"], "settings": {"tag": "div", "visibility": true, "block": {"tag": "div"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element": "ecfeb363-affd-ace2-0b8a-de2183a41d4e"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6a362c72491d6977ea71846c", "element":