653c29ffaba3"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffaba1"}, "type": "String", "textContent": "How fast will we hear back?"}]}, {"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffaba5"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffaba4"}, "type": "String", "textContent": "Within 24 hours on business days. Rush dates get a same-day call."}]}]}, {"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabae"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabaa"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffaba8"}, "type": "String", "textContent": "What do you need to quote?"}]}, {"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabac"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabab"}, "type": "String", "textContent": "The date, the place, how many people, and what has to happen. A floor plan or run of show helps, but isn't required."}]}]}, {"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabb5"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabb1"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabaf"}, "type": "String", "textContent": "Is there a minimum project size?"}]}, {"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabb3"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabb2"}, "type": "String", "textContent": "Event packages start around $2,500. Smaller jobs are welcome too: send a message and we'll suggest what fits."}]}]}, {"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabbc"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabb8"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabb6"}, "type": "String", "textContent": "Do you work outside New York?"}]}, {"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabba"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabb9"}, "type": "String", "textContent": "Yes. We are based in Brooklyn, New York, and the same crew travels with the equipment."}]}]}, {"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabc3"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabbf"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabbd"}, "type": "String", "textContent": "Can you work with our agency, producer or venue team?"}]}, {"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabc1"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6af97b78d8e68fc36722099d", "element": "0f89bc98-dcfb-d4c1-887f-653c29ffabc0"}, "type": "String", "textContent": "Yes. We coordinate directly with venue operations, producers and in-house teams, and carry the insurance most venues ask for."}]}]}]}]}, {"id": {"component": "6af97b78d8e68fc36722099d", "element": "c7517e01-ba77-1522-b783-ca01787a6d58"}, "type": "ComponentInstance", "instanceDetails": {"type": "ComponentInstance", "id": "fcf0ee38-0d76-5cd2-c260-debfab4e501c", "name": "NX Footer", "props": [], "slots": []}}]}