-f925-0632-29a00d5bbf07"}, "type": "String", "textContent": "What if the event runs late?"}]}, {"id": {"component": "6aff6c89b046f1fa36efdfa9", "element": "097afc07-d71b-f925-0632-29a00d5bbf0b"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6aff6c89b046f1fa36efdfa9", "element": "097afc07-d71b-f925-0632-29a00d5bbf0a"}, "type": "String", "textContent": "Tell the technician on site. Added hours are agreed with you before they are billed."}]}]}, {"id": {"component": "6aff6c89b046f1fa36efdfa9", "element": "097afc07-d71b-f925-0632-29a00d5bbf14"}, "type": "DOM", "settings": {"tag": "details", "visibility": true, "dom": {"tag": "details"}}, "children": [{"id": {"component": "6aff6c89b046f1fa36efdfa9", "element": "097afc07-d71b-f925-0632-29a00d5bbf10"}, "type": "DOM", "settings": {"tag": "summary", "visibility": true, "dom": {"tag": "summary"}}, "children": [{"id": {"component": "6aff6c89b046f1fa36efdfa9", "element": "097afc07-d71b-f925-0632-29a00d5bbf0e"}, "type": "String", "textContent": "Who do I contact on the day?"}]}, {"id": {"component": "6aff6c89b046f1fa36efdfa9", "element": "097afc07-d71b-f925-0632-29a00d5bbf12"}, "type": "Paragraph", "settings": {"visibility": true}, "children": [{"id": {"component": "6aff6c89b046f1fa36efdfa9", "element": "097afc07-d71b-f925-0632-29a00d5bbf11"}, "type": "String", "textContent": "Your quote names one contact, and the technician on site handles everything during the event."}]}]}]}]}, {"id": {"component": "6aff6c89b046f1fa36efdfa9", "element": "2839b709-c550-4fd5-1c28-1a1a0ae3fb1a"}, "type": "Block", "styleNames": ["next", "end"], "attributes": {"id": "quote"}, "settings": {"tag": "section", "visibility": true, "block": {"tag": "section"}}, "children": [{"id": {"component": "6aff6c89b046f1fa36efdfa9", "element": "2839b709-c550-4fd5-1c28-1a1a0ae3fb10"}, "type": "Paragraph", "styleNames": ["mono", "eb"], "settings": {"visibility": true}, "children": [{"id": {"component": "6aff6c89b046f1fa36ef